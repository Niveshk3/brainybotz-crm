# BrainyBotz CRM environment configuration
# Copy this file to .env for local/private configuration. Never commit .env.

DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# When deployed behind HTTPS:
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_HSTS_SECONDS=31536000
# Example: https://crm.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://crm.example.com

# Email
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=BrainyBotz CRM <noreply@brainybotz.com>

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5
